{
  "manifest_version": 3,
  "name": "Short-Form Blocker: YouTube Shorts & Instagram Reels",
  "short_name": "Short-Form Blocker",
  "version": "1.1.0",
  "description": "Removes YouTube Shorts and Instagram Reels from your feeds, and opens Shorts and Reels links without the endless swipe feed.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "declarativeNetRequest"],
  "host_permissions": [
    "*://youtube.com/*",
    "*://www.youtube.com/*",
    "*://m.youtube.com/*",
    "*://instagram.com/*",
    "*://www.instagram.com/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "youtube_to_watch",
        "enabled": true,
        "path": "rules/youtube_to_watch.json"
      },
      {
        "id": "youtube_to_home",
        "enabled": false,
        "path": "rules/youtube_to_home.json"
      },
      {
        "id": "instagram_to_single",
        "enabled": true,
        "path": "rules/instagram_to_single.json"
      },
      {
        "id": "instagram_to_home",
        "enabled": false,
        "path": "rules/instagram_to_home.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "*://youtube.com/*",
        "*://www.youtube.com/*",
        "*://m.youtube.com/*"
      ],
      "js": ["src/defaults.js", "src/content.js"],
      "css": ["src/sites/youtube.css"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://instagram.com/*", "*://www.instagram.com/*"],
      "js": ["src/defaults.js", "src/content.js"],
      "css": ["src/sites/instagram.css"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Short-Form Blocker",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  }
}
